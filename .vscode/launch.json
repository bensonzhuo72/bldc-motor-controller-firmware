{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug (OpenOCD + SWO)",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "openocd",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/Debug/Motor_Controller.elf",
            "device": "STM32G491RE",
            "runToEntryPoint": "main",
            "showDevDebugOutput": "none",
            "searchDir": [
                "${env:BLDC_OPENOCD_SCRIPTS}"
            ],
            "configFiles": [
                "interface/stlink-dap.cfg",
                "target/stm32g4x.cfg"
            ],
            "svdFile": "${env:BLDC_SVD}",
            "swoConfig": {
                "enabled": true,
                "cpuFrequency": 170000000,
                "swoFrequency": 2000000,
                "source": "probe",
                "decoders": [
                    {
                        "type": "console",
                        "label": "SWO",
                        "port": 0,
                        "encoding": "ascii"
                    }
                ]
            }
        }
    ]
}
